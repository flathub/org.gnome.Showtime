{
  "id": "org.gnome.Showtime",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "command": "showtime",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--filesystem=xdg-pictures/Screenshots:create"
  ],
  "add-extensions": {
    "org.freedesktop.Platform.ffmpeg-full": {
      "version": "24.08",
      "directory": "lib/ffmpeg",
      "add-ld-path": ".",
      "no-autodownload": false,
      "autodelete": false
    }
  },
  "cleanup-commands": ["mkdir -p ${FLATPAK_DEST}/lib/ffmpeg"],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "blueprint-compiler",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler",
          "tag": "v0.16.0"
        }
      ],
      "cleanup": ["*"]
    },
    {
      "name": "gstreamer",
      "buildsystem": "meson",
      "config-opts": [
        "-Dexamples=disabled",
        "-Dbenchmarks=disabled",
        "-Dintrospection=enabled"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.freedesktop.org/gstreamer/gstreamer.git",
          "tag": "1.26.0",
          "commit": "d31ce8e5e1aacf8f5e5beabb5c81ce2e4da5c202"
        },
      ]
    },
    {
      "name": "showtime",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/Incubator/showtime.git",
          "tag": "48.0",
          "commit": "d35bff5a868438f17ae874e92b910da03b9e99e5"
        }
      ]
    }
  ]
}
