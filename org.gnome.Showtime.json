{
    "id": "org.gnome.Showtime",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "showtime",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "showtime",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/showtime/50/showtime-50.0.tar.xz",
                    "sha256": "4399c9fa7f61e5984242e279acd1519beec246b98a676d44a4b2ab94e9eecb01",
                    "x-checker-data": {
                        "type": "gnome",
                        "is-important": true,
                        "name": "showtime"
                    }
                }
            ]
        }
    ]
}
