{
    "id": "org.gnome.Showtime",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "command": "showtime",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--filesystem=xdg-pictures/Screenshots:create"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "showtime",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/showtime/49/showtime-49.0.tar.xz",
                    "sha256": "5abcaf97ab5e9530038282848588e8ce6c26173b7303ef6756bebdb0b20ed398",
                    "x-checker-data": {
                        "type": "gnome",
                        "is-important": true,
                        "name": "showtime"
                    }
                }
            ]
        }
    ]
}
